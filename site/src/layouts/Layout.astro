---
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/500.css';
import '@fontsource/public-sans/600.css';
import '@fontsource/public-sans/700.css';
import '@fontsource/public-sans/500-italic.css';
import '@fontsource/newsreader/300.css';
import '@fontsource/newsreader/300-italic.css';
import '@fontsource/newsreader/400.css';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import { staticPages } from '../lib/seo/registry';
import { runs } from '../data/derived';
import { tracks } from '../data';
import { taskNames } from '../data/labels';
import { urls, indexable, serializeJson } from '../lib/seo/config';
import { findPage, markdownPath, imagePath } from '../lib/seo/registry';
import { schemaGraph } from '../lib/seo/schema';
const { title: fallbackTitle, description: fallbackDescription } = Astro.props;
const page = findPage(Astro.url.pathname);
const title = page?.title || `${fallbackTitle || 'Página não encontrada'} · Teor`;
const description =
  page?.description ||
  fallbackDescription ||
  'Página não encontrada no Teor. Consulte resultados, perguntas e metodologia do benchmark legislativo.';
const canonical = page ? urls.absolute(page.path) : new URL(Astro.url.pathname, urls.origin).href;
const image = urls.absolute(page ? imagePath(page) : 'og/teor.png');
const robots =
  page?.index && indexable
    ? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
    : 'noindex, follow';
const base = urls.base;
const links = [
  ['modelos/', 'Resultados'],
  ['comparar/', 'Comparar'],
  ['explorador/', 'Itens'],
  ['trilhas/', 'Trilhas'],
  ['quiz/', 'Quiz'],
];
const methodLinks = {
  Entender: [
    ['metodologia/', 'Metodologia', 'Trilhas, modos, métricas e bootstrap'],
    ['analises/interpretacao/', 'Como ler uma nota', 'O que um resultado permite concluir'],
    ['dados/', 'Dados e fontes', 'Origem, formato e condições de reuso'],
    ['rodadas/', 'Rodadas', 'Lotes novos com gabarito tardio'],
  ],
  Participar: [
    ['contribuir/', 'Avaliar um modelo', 'Rodar o protocolo e submeter'],
    ['revisar/', 'Revisar itens', 'Gabaritos e fidelidade das citações'],
    ['erratas/', 'Erratas', 'Correções versionadas'],
    ['como-citar/', 'Como citar', 'Software, execução e fonte'],
  ],
};
const methodPaths = Object.values(methodLinks).flat().map(([p]) => p).concat(['analises/', 'sobre/']);
const current = urls.relative(Astro.url.pathname) ?? '';
const isCurrent = (href: string) => (href ? current.startsWith(href) : current === '');
const methodActive = methodPaths.some((p) => current.startsWith(p));
const cmdkIndex = {
  base,
  pages: staticPages.map((p) => ({ name: p.name, path: p.path, description: p.description })),
  runs: runs.map((r) => ({ label: r.label, slug: r.slug, org: r.org, kind: r.kind })),
  tracks,
  tasks: taskNames,
};
const year = new Date().getFullYear();
const umami = import.meta.env.PUBLIC_UMAMI_URL;
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
---

<!doctype html>
<html lang="pt-BR" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content="Como Votam" />
    {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta
        name="google-site-verification"
        content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION}
      />
    )}
    {import.meta.env.PUBLIC_BING_SITE_VERIFICATION && (
      <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION} />
    )}

    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={page?.article ? 'article' : 'website'} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Teor" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:secure_url" content={image.startsWith('https:') ? image : undefined} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={
        page
          ? `${page.name} — Teor, por Como Votam`
          : 'Teor — benchmark legislativo, por Como Votam'
      }
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta
      name="twitter:image:alt"
      content={page ? `${page.name} — Teor, por Como Votam` : 'Teor — benchmark legislativo'}
    />
    <meta name="theme-color" content="#f9f9fb" />
    <link rel="icon" type="image/svg+xml" sizes="any" href={urls.path('favicon.svg')} />
    <link rel="icon" type="image/png" sizes="48x48" href={urls.path('icons/48.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={urls.path('icons/180.png')} />
    <link rel="manifest" href={urls.path('site.webmanifest')} />
    <link rel="sitemap" type="application/xml" href={urls.path('sitemap.xml')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Execuções publicadas no Teor"
      href={urls.path('feed.xml')}
    />
    {page && (
      <link
        rel="alternate"
        type="text/markdown"
        title={`${page.name} em Markdown`}
        href={urls.path(markdownPath(page))}
      />
    )}
    {page && (
      <script is:inline type="application/ld+json" set:html={serializeJson(schemaGraph(page))} />
    )}
    {umami && umamiId && <script is:inline defer src={umami} data-website-id={umamiId}></script>}
  </head>
  <body>
    <a class="skip" href="#conteudo">Ir para o conteúdo</a>
    <header class="site-header">
      <div class="shell header-row">
        <Logo />
        <nav class="nav" aria-label="Principal">
          <span class="nav-lens" aria-hidden="true"></span>
          {
            links.map(([href, label]) => (
              <a
                class="nav-link"
                href={`${base}${href}`}
                aria-current={isCurrent(href) ? 'page' : undefined}
              >
                {label}
              </a>
            ))
          }
          <div style="position:relative;height:100%;display:flex;align-items:center">
            <button
              class="nav-link"
              type="button"
              data-menu-trigger
              aria-expanded="false"
              aria-controls="menu-metodo"
              aria-current={methodActive ? 'page' : undefined}
            >
              Método <Icon name="caret-down" weight="regular" size={14} class="chev" />
            </button>
            <div class="nav-menu" id="menu-metodo" hidden>
              <div class="nav-menu-grid">
                {
                  Object.entries(methodLinks).map(([group, items], g) => (
                    <div>
                      <p class="col-label">{group}</p>
                      {items.map(([href, label, hint], i) => (
                        <a class="menu-link" href={`${base}${href}`} style={`--i:${g * 4 + i}`}>
                          <strong>{label}</strong>
                          <span>{hint}</span>
                        </a>
                      ))}
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </nav>
        <div class="header-actions">
          <button class="cmdk-trigger" type="button" data-cmdk aria-label="Buscar (atalho: barra)">
            <Icon name="magnifying-glass" weight="regular" size={15} />
            <span>Buscar</span>
            <span style="display:inline-flex;gap:3px"><kbd data-mod-key>Ctrl</kbd><kbd>K</kbd></span>
          </button>
          <span class="header-sep" aria-hidden="true"></span>
          <a class="icon-btn" href="https://github.com/como-votam/teor" aria-label="Código do Teor no GitHub">
            <Icon name="github-logo" weight="regular" size={20} />
          </a>
          <button class="icon-btn menu-toggle" type="button" data-mobile-nav aria-label="Abrir menu">
            <Icon name="list" weight="regular" size={20} />
          </button>
        </div>
      </div>
      <span class="scroll-progress" aria-hidden="true"></span>
    </header>
    <template id="mobile-nav">
      {
        links.map(([href, label], i) => (
          <a href={`${base}${href}`} style={`--i:${i}`} aria-current={isCurrent(href) ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
      {
        Object.entries(methodLinks).map(([group, items]) => (
          <div class="small">
            <p class="col-label">{group}</p>
            {items.map(([href, label], i) => (
              <a href={`${base}${href}`} style={`--i:${i + 5}`}>
                {label}
              </a>
            ))}
          </div>
        ))
      }
    </template>
    <main id="conteudo">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <Logo inverted />
          <p>
            Benchmark aberto de modelos de linguagem sobre o processo legislativo brasileiro. Mantido
            pelo Como Votam, sem vínculo com partidos, campanhas, órgãos públicos ou fornecedores de
            modelos.
          </p>
          <div class="footer-social">
            <a href="https://github.com/como-votam/teor" aria-label="Teor no GitHub">
              <Icon name="github-logo" weight="regular" size={20} />
            </a>
            <a href="https://comovotam.com.br" aria-label="Site do Como Votam">
              <Icon name="globe-simple" weight="regular" size={20} />
            </a>
          </div>
        </div>
        <nav class="footer-col" aria-label="Explorar">
          <h2>Explorar</h2>
          <a href={`${base}modelos/`}>Resultados</a>
          <a href={`${base}comparar/`}>Comparar execuções</a>
          <a href={`${base}explorador/`}>Itens e console SQL</a>
          <a href={`${base}trilhas/`}>Trilhas</a>
          <a href={`${base}quiz/`}>Quiz</a>
        </nav>
        <nav class="footer-col" aria-label="Método">
          <h2>Método</h2>
          <a href={`${base}metodologia/`}>Metodologia</a>
          <a href={`${base}analises/`}>Análises</a>
          <a href={`${base}dados/`}>Dados e fontes</a>
          <a href={`${base}rodadas/`}>Rodadas</a>
          <a href={`${base}erratas/`}>Erratas</a>
        </nav>
        <nav class="footer-col" aria-label="Projeto">
          <h2>Projeto</h2>
          <a href={`${base}sobre/`}>Sobre o Teor</a>
          <a href={`${base}contribuir/`}>Avaliar um modelo</a>
          <a href={`${base}revisar/`}>Revisar itens</a>
          <a href={`${base}como-citar/`}>Como citar</a>
          <a href="https://comovotam.com.br">Como Votam</a>
        </nav>
      </div>
      <div class="shell">
        <div class="footer-bottom">
          <span>© {year} Como Votam · Código sob Apache 2.0</span>
          <nav aria-label="Arquivos para máquinas">
            <a href={`${base}llms.txt`}>llms.txt</a>
            <a href={`${base}resultados/index.json`}>resultados.json</a>
            <a href={`${base}sitemap.xml`}>Sitemap</a>
            <a href={`${base}feed.xml`}>RSS</a>
            <a href="https://comovotam.com.br/privacidade">Privacidade</a>
            <a href="https://comovotam.com.br/termos">Termos</a>
          </nav>
          <button type="button" data-top>
            <Icon name="arrow-up" weight="regular" size={15} /> Voltar ao topo
          </button>
        </div>
      </div>
    </footer>
    <script type="application/json" id="cmdk-index" set:html={serializeJson(cmdkIndex)} />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
