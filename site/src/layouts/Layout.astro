---
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/600.css';
import '@fontsource/newsreader/500.css';
import '@fontsource/space-mono/400.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { urls, indexable, serializeJson } from '../lib/seo/config';
import { findPage, markdownPath, imagePath } from '../lib/seo/registry';
import { schemaGraph } from '../lib/seo/schema';
const { title: fallbackTitle, description: fallbackDescription } = Astro.props;
const page = findPage(Astro.url.pathname);
const title = page?.title || `${fallbackTitle || 'Página não encontrada'} · Teor`;
const description =
  page?.description ||
  fallbackDescription ||
  'Página não encontrada no Teor. Consulte resultados, perguntas e metodologia do benchmark legislativo.';
const canonical = page ? urls.absolute(page.path) : new URL(Astro.url.pathname, urls.origin).href;
const image = urls.absolute(page ? imagePath(page) : 'og/teor.png');
const robots =
  page?.index && indexable
    ? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
    : 'noindex, follow';
const base = urls.base;
const links = [
  ['', 'Comparar'],
  ['explorador/', 'Explorar itens'],
  ['quiz/', 'Teste você'],
  ['analises/', 'Análises'],
  ['rodadas/', 'Rodadas'],
  ['metodologia/', 'Metodologia'],
];
const umami = import.meta.env.PUBLIC_UMAMI_URL;
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content="Como Votam" />
    {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta
        name="google-site-verification"
        content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION}
      />
    )}
    {import.meta.env.PUBLIC_BING_SITE_VERIFICATION && (
      <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION} />
    )}

    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={page?.article ? 'article' : 'website'} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Teor" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:secure_url" content={image.startsWith('https:') ? image : undefined} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={
        page
          ? `${page.name} — Teor, por Como Votam`
          : 'Teor — benchmark legislativo, por Como Votam'
      }
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta
      name="twitter:image:alt"
      content={page ? `${page.name} — Teor, por Como Votam` : 'Teor — benchmark legislativo'}
    />
    <meta name="theme-color" content="#f9f9fb" />
    <link rel="icon" type="image/svg+xml" sizes="any" href={urls.path('favicon.svg')} />
    <link rel="icon" type="image/png" sizes="48x48" href={urls.path('icons/48.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={urls.path('icons/180.png')} />
    <link rel="manifest" href={urls.path('site.webmanifest')} />
    <link rel="sitemap" type="application/xml" href={urls.path('sitemap.xml')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Execuções publicadas no Teor"
      href={urls.path('feed.xml')}
    />
    {page && (
      <link
        rel="alternate"
        type="text/markdown"
        title={`${page.name} em Markdown`}
        href={urls.path(markdownPath(page))}
      />
    )}
    {page && (
      <script is:inline type="application/ld+json" set:html={serializeJson(schemaGraph(page))} />
    )}
    {umami && umamiId && <script is:inline defer src={umami} data-website-id={umamiId}></script>}
  </head>
  <body>
    <a class="skip" href="#conteudo">
      Ir para o conteúdo
    </a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href={base} aria-label="Teor, página inicial">
          <img src={`${base}brand.svg`} width="32" height="36" alt="" />
          <span>
            teor<span class="brand-by">por Como Votam</span>
          </span>
        </a>
        <nav id="main-nav" aria-label="Principal">
          {links.map(([href, label]) => (
            <a
              href={`${base}${href}`}
              aria-current={
                (
                  href
                    ? Astro.url.pathname.startsWith(`${base}${href}`)
                    : Astro.url.pathname === base
                )
                  ? 'page'
                  : undefined
              }
            >
              {label}
            </a>
          ))}
        </nav>
        <a
          class="repo"
          aria-label="Código aberto do Teor no GitHub"
          href="https://github.com/como-votam/teor"
        >
          <Icon name="code" />
          <span>Código aberto</span>
        </a>
        <button
          class="menu-toggle ghost"
          aria-expanded="false"
          aria-controls="main-nav"
          aria-label="Abrir navegação"
        >
          <span></span>
          <span></span>
        </button>
      </div>
    </header>
    <main id="conteudo">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <a class="wordmark" href={base}>
            <img src={`${base}brand.svg`} width="32" height="36" alt="" />
            <span>
              teor<span class="brand-by">por Como Votam</span>
            </span>
          </a>
          <p>
            O que a IA sabe sobre o Legislativo?
            <br />
            Um benchmark para conferir a resposta.
          </p>
          <a class="text-link" href="https://comovotam.com.br">
            Conheça o Como Votam <Icon name="external" size={16} />
          </a>
        </div>
        <nav aria-label="Informações">
          <span class="eyebrow">O projeto</span>
          <a href={`${base}sobre/`}>Sobre o Teor</a>
          <a href={`${base}trilhas/`}>Trilhas de avaliação</a>
          <a href={`${base}modelos/`}>Modelos e baselines</a>
          <a href={`${base}dados/`}>Dados e fontes</a>
          <a href={`${base}como-citar/`}>Como citar</a>
          <a href={`${base}erratas/`}>Erratas</a>
          <a href={`${base}contribuir/`}>Contribuir</a>
          <a href={`${base}revisar/`}>Revisar itens</a>
        </nav>
        <div class="footer-note">
          <span class="eyebrow">Pesquisa aberta</span>
          <p>
            Compreensão, previsão e uso de ferramentas têm métricas próprias. A evidência acompanha
            cada resultado.
          </p>
          <a href="https://github.com/como-votam/teor/blob/main/LICENSE">Código sob Apache 2.0 ↗</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>Teor · Como Votam</span>
        <span>
          <a href={`${base}llms.txt`}>Índice para agentes</a> ·{' '}
          <a href={`${base}sitemap.xml`}>Mapa do site</a> · <a href={`${base}feed.xml`}>RSS</a>
        </span>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
      const nav = document.getElementById('main-nav')!;
      function setMenu(open: boolean) {
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Fechar navegação' : 'Abrir navegação');
        nav.classList.toggle('is-open', open);
      }
      toggle.addEventListener('click', () =>
        setMenu(toggle.getAttribute('aria-expanded') !== 'true'),
      );
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
          setMenu(false);
          toggle.focus();
        }
      });
      nav
        .querySelectorAll('a')
        .forEach((link) => link.addEventListener('click', () => setMenu(false)));
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 },
      );
      document
        .querySelectorAll('[data-reveal], .tagline span')
        .forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
