---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import { tracks } from '../../data';
import { taskNames } from '../../data/labels';
import { trackDetails } from '../../lib/seo/content';
import { trackCounts, itemSummaries } from '../../data/derived';
import { int, pct } from '../../lib/format';
import { tipData } from '../../lib/charts';
const base = import.meta.env.BASE_URL;
const total = itemSummaries.length;
const tasksOf = (id: string) => [...new Set(itemSummaries.filter((i) => i.track === id).map((i) => i.task))];
---

<Layout title="Trilhas de avaliação">
  <Breadcrumbs />
  <section class="shell page-hero">
    <p class="eyebrow">Trilhas</p>
    <h1 class="h-page">Oito capacidades, medidas uma de cada vez</h1>
    <p class="sub">
      Compreensão factual, regras, contagem, tramitação, previsão, citação, ferramentas e paridade.
      Nenhuma delas entra numa média com as outras.
    </p>
  </section>
  <section class="shell" style="padding-bottom:96px">
    <div class="composition" role="img" aria-label={tracks.map(([id]) => `${id}: ${trackCounts[id]} itens`).join(', ')}>
      {
        tracks.map(([id, name], i) => (
          <span style={`flex:${trackCounts[id] || 0};--i:${i}`} data-tip={tipData(`Trilha ${id} · ${name}`, `${int(trackCounts[id] || 0)} itens`, [['Parte do conjunto', pct((trackCounts[id] || 0) / Math.max(1, total))]])}>
            {(trackCounts[id] || 0) / total > 0.06 && <span class="lbl">{id}</span>}
          </span>
        ))
      }
    </div>
    <div class="list-rows" style="margin-top:32px">
      {
        tracks.map(([id, name, description]) => (
          <a class="list-row" href={`${base}trilhas/${id.toLowerCase()}/`} data-row>
            <div style="display:grid;grid-template-columns:40px minmax(0,1fr);gap:16px;align-items:start">
              <span class="code-tag" style="width:32px;height:32px;font-size:14px;margin-top:2px">{id}</span>
              <div>
                <h2 class="h-block" style="font-size:22px">{name}</h2>
                <p>{description} {trackDetails[id].question}</p>
                <div class="ex-tags">
                  {tasksOf(id).map((t) => (
                    <span class="badge badge--muted">{taskNames[t] || t}</span>
                  ))}
                </div>
              </div>
            </div>
            <span style="display:flex;align-items:center;gap:16px">
              <span class="fine tnum">{int(trackCounts[id] || 0)} itens</span>
              <span class="go"><Icon name="arrow-right" weight="regular" size={18} /></span>
            </span>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
