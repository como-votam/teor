---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import { data, tracks } from '../data';
const base = import.meta.env.BASE_URL;
---

<Layout title="Explorar itens">
  <Breadcrumbs />
  <div class="page-intro">
    <p class="eyebrow">Dados e gabaritos públicos</p>
    <h1>
      Cada pergunta,
      <br />
      com sua fonte.
    </h1>
    <p class="lead">
      Veja o contexto, o gabarito e a evidência que sustenta cada item. Os arquivos são consultados
      no seu navegador.
    </p>
  </div>
  <div class="explorer-layout">
    <aside class="explorer-sidebar" aria-label="Filtros dos itens">
      <div class="filters">
        <label>
          <span>
            <Icon name="search" size={16} /> Buscar pergunta
          </span>
          <input id="search" type="search" placeholder="Autoria, quórum, votação…" />
        </label>
        <label>
          Trilha
          <select id="explorer-track">
            <option value="">Todas as trilhas</option>
            {tracks.map(([id, name]) => (
              <option value={id}>
                {id} · {name}
              </option>
            ))}
          </select>
        </label>
        <button id="load" type="button" disabled={!data.partitions.length}>
          Carregar próxima partição
        </button>
      </div>
      <p>O carregamento é feito por partição. A busca considera os itens já carregados.</p>
      <a class="text-link" href={`${base}dados/`}>
        Sobre os dados <Icon name="arrow" size={16} />
      </a>
    </aside>
    <section aria-label="Itens públicos">
      <p id="explorer-status" role="status">
        {data.count
          ? `${data.count.toLocaleString('pt-BR')} itens disponíveis; carregamento sob demanda.`
          : 'Nenhum conjunto público exportado.'}
      </p>
      <div id="items">
        <div class="empty">
          <Icon name="book" size={32} />
          <h2>
            {data.partitions.length
              ? 'Abra a primeira partição'
              : 'O conjunto ainda não foi exportado'}
          </h2>
          <p>
            {data.partitions.length
              ? 'Carregue os dados para consultar as perguntas. Depois, use a busca e o filtro de trilha para encontrar um item.'
              : 'O explorador receberá perguntas e fontes quando houver uma exportação pública. Consulte a política de dados para conhecer o formato e os limites de uso.'}
          </p>
          <a class="text-link" href={`${base}dados/`}>
            Consultar dados e fontes <Icon name="arrow" size={16} />
          </a>
        </div>
      </div>
    </section>
  </div>
  <script
    type="application/json"
    id="partitions"
    set:html={JSON.stringify(data.partitions).replaceAll('<', '\u003c')}
  />
</Layout>
<script src="../scripts/explorer.ts"></script>
