---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import DocShell from '../components/DocShell.astro';
import Icon from '../components/Icon.astro';
import { softwareVersion } from '../lib/seo/citation';
import { urls, SOURCES } from '../lib/seo/config';
import { modelPages } from '../lib/seo/registry';
import { modelName } from '../data';
const software = `Como Votam. Teor: benchmark aberto do processo legislativo brasileiro. Versão ${softwareVersion}. ${urls.absolute()}`;
const template = `Teor. Modelo: [identificador]. Execução: [id e data].
Tarefa: [trilha e tarefa]. Casa: [Câmara ou Senado].
Modo: [com contexto, sem contexto ou ferramentas].
Divisão: [split]. Qualidade temporal: [classificação].
Conjunto: [hash completo]. Protocolo: [hash completo].
Resultado: [nota e IC 95%]. Cobertura: [percentual].
Verificação: [estado]. Fonte: [URL do perfil ou JSON].`;
const headings = [
  { depth: 2, slug: 'software', text: 'Citar o software' },
  { depth: 2, slug: 'execucao', text: 'Citar uma execução' },
  { depth: 2, slug: 'resultados', text: 'Resultados disponíveis' },
  { depth: 2, slug: 'fontes', text: 'Fontes primárias' },
];
---

<Layout title="Como citar">
  <Breadcrumbs />
  <DocShell current="como-citar" headings={headings}>
    <h1>Cite o experimento junto com a nota</h1>
    <p>
      A versão do software não substitui o conjunto e o protocolo da avaliação. Um número só é
      interpretável com a tarefa e as condições que o produziram.
    </p>
    <h2 id="software">Citar o software</h2>
    <div class="cite">
      {software}
      <button class="icon-btn copy" type="button" data-copy={software} aria-label="Copiar referência">
        <Icon name="copy" weight="regular" size={16} class="ico-copy" />
        <Icon name="check" weight="bold" size={16} class="ico-check" />
      </button>
    </div>
    <p>
      <a href={urls.path('CITATION.cff')} download>Baixar CFF</a> · <a href={urls.path('citation.bib')} download>Baixar BibTeX</a>
    </p>
    <h2 id="execucao">Citar uma execução</h2>
    <p>
      Informe modelo, execução, tarefa, casa, modo, divisão, qualidade temporal, hashes completos,
      nota com intervalo, cobertura e verificação.
    </p>
    <div class="cite">
      {template}
      <button class="icon-btn copy" type="button" data-copy={template} aria-label="Copiar modelo de citação">
        <Icon name="copy" weight="regular" size={16} class="ico-copy" />
        <Icon name="check" weight="bold" size={16} class="ico-check" />
      </button>
    </div>
    <p>
      Uma referência determinística não é um LLM. Uma submissão autodeclarada não deve ser descrita
      como verificada. Previsão retrospectiva não demonstra previsão prospectiva.
    </p>
    <h2 id="resultados">Resultados disponíveis</h2>
    <ul>
      {modelPages.map((p) => (<li><a href={urls.path(p.path)}>{modelName(p.model!)}</a></li>))}
    </ul>
    <p><a href={urls.path('resultados/index.json')}>Catálogo de métricas em JSON</a></p>
    <h2 id="fontes">Fontes primárias</h2>
    <ul>
      {SOURCES.map((s) => (<li><a href={s.url}>{s.name}</a></li>))}
    </ul>
    <p>
      Ao citar um fato legislativo, cite também a evidência do item. Veja as <a href={urls.path('dados/')}>condições de reuso</a> e a{' '}
      <a href={urls.path('erratas/')}>política de correções</a>.
    </p>
  </DocShell>
</Layout>
