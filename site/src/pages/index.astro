---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { data, tracks } from '../data';
import { taskNames, modeNames, chamberNames } from '../data/labels';
import {
  runs,
  models,
  principalSlices,
  trackCounts,
  itemSummaries,
  liftSummary,
  clientPayload,
} from '../data/derived';
import { faqs, trackDetails } from '../lib/seo/content';
import { serializeJson } from '../lib/seo/config';
import { seqColor, liftColor, pct, pp, int } from '../lib/format';
import { tipData, seriesColor } from '../lib/charts';
import { contextSummary, answerTokens, hostOf } from '../lib/item-view';
const base = import.meta.env.BASE_URL;

// Espécime do hero: itens reais do quiz, com a nota do primeiro modelo naquela fatia.
const lead = models[0];
const specimens = data.quiz.map((item) => {
  const slice = principalSlices.find(
    (s) => s.task === item.task && s.chamber === item.chamber && s.mode === item.mode,
  );
  const cell = lead && slice?.cells[lead.id];
  return {
    id: item.id,
    track: item.track,
    task: taskNames[item.task] || item.task,
    chamber: chamberNames[item.chamber] || item.chamber,
    ref: item.evidence[0]?.ref || '',
    url: item.evidence[0]?.url || '',
    host: hostOf(item.evidence[0]?.url || ''),
    prompt: item.prompts[0],
    context: contextSummary(item),
    answer: answerTokens(item),
    model: cell && lead ? `${lead.label} acerta ${pct(cell.mean)} nesta tarefa` : '',
  };
});
const first = specimens[0];

// Matriz: linhas = tarefa × modo, colunas = execuções; uma tabela por casa.
const columns = runs;
const chambers = ['camara', 'senado'];
const rowKeys = [...new Set(principalSlices.map((s) => `${s.task}|${s.mode}`))];
const rowsByTrack = tracks
  .map(([id, name]) => ({
    id,
    name,
    rows: rowKeys
      .filter((k) => principalSlices.find((s) => `${s.task}|${s.mode}` === k)?.track === id)
      .map((k) => {
        const [task, mode] = k.split('|');
        return { task, mode };
      }),
  }))
  .filter((g) => g.rows.length);
const sliceFor = (task: string, mode: string, chamber: string) =>
  principalSlices.find((s) => s.task === task && s.mode === mode && s.chamber === chamber);

const lifts = models.map((m) => ({ run: m, ...liftSummary(m.id) }));
const modelCount = models.length;
const totalItems = data.count;

const pipeline = [
  {
    title: 'Coletar',
    body: 'Baixa proposições, votações e tramitação das APIs oficiais para um snapshot selado por hash.',
    code: [
      ['c', '# snapshot de um mês, com cache por URL'],
      ['p', 'uv run teor collect --start 2026-09-01 --end 2026-09-30 \\'],
      ['o', '    --output data/setembro-2026'],
      ['p', 'uv run teor snapshot verify data/setembro-2026'],
      ['k', '✓ manifesto selado · hashes conferem'],
    ],
  },
  {
    title: 'Construir',
    body: 'Gera os itens com três variantes de prompt, separa famílias entre dev e teste e grava o canário.',
    code: [
      ['c', '# itens públicos, splits e gabaritos privados'],
      ['p', 'uv run teor build data/setembro-2026 --output data/benchmark'],
      ['p', 'uv run teor validate data/benchmark/items.jsonl'],
      ['k', `✓ ${int(totalItems)} itens públicos · 8 trilhas · 2 casas`],
    ],
  },
  {
    title: 'Avaliar',
    body: 'Roda o modelo com teto de orçamento. Um preflight confere o formato das respostas antes do run inteiro.',
    code: [
      ['c', '# preflight automático: aborta se >15% vier fora do formato'],
      ['p', 'uv run teor run data/benchmark/test-lite.jsonl \\'],
      ['o', '    --model provider/model --prices config/prices.json \\'],
      ['o', '    --budget 10 --output data/previsoes.jsonl'],
    ],
  },
  {
    title: 'Pontuar',
    body: 'Calcula nota por fatia com bootstrap por família e gera o JSON que acompanha o pull request.',
    code: [
      ['c', '# IC 95%, 2.000 reamostragens por família'],
      ['p', 'uv run teor score data/benchmark/test-lite.jsonl data/previsoes.jsonl \\'],
      ['o', '    --output reports/modelo.json'],
      ['p', 'uv run teor submission validate reports/modelo.json'],
    ],
  },
];
const examplePrompt = (track: string) => itemSummaries.find((i) => i.track === track)?.prompt || '';
const trackTasks = (track: string) => [
  ...new Set(itemSummaries.filter((i) => i.track === track).map((i) => taskNames[i.task] || i.task)),
];
const trackPayload = tracks.map(([id, name, desc]) => ({
  id,
  name,
  desc,
  n: trackCounts[id],
  ...trackDetails[id],
  tasks: trackTasks(id),
  example: examplePrompt(id),
}));
const firstTrack = trackPayload[0];
---

<Layout title="A IA entende o Congresso?">
  <section class="shell home-hero">
    <div>
      <p class="eyebrow">Benchmark aberto · Câmara e Senado</p>
      <h1 class="h-display">
        O Congresso brasileiro como <em>prova</em> para modelos de linguagem.
      </h1>
      <p class="lead">
        {int(totalItems)} perguntas tiradas de registros oficiais da Câmara e do Senado, em oito trilhas
        medidas separadamente. Cada nota sai com intervalo de confiança, e cada gabarito aponta a fonte.
      </p>
      <div class="hero-actions">
        <a class="btn btn--lg" href="#resultados">
          Ver os resultados <Icon name="arrow-down" weight="regular" size={18} />
        </a>
        <a class="btn btn--ghost btn--lg" href={`${base}explorador/`}>Abrir os itens</a>
      </div>
      <div class="hero-cmd">
        <code>git clone https://github.com/como-votam/teor && cd teor && uv sync</code>
        <button
          class="icon-btn copy"
          type="button"
          data-copy="git clone https://github.com/como-votam/teor && cd teor && uv sync"
          aria-label="Copiar comando"
        >
          <Icon name="copy" weight="regular" size={16} class="ico-copy" />
          <Icon name="check" weight="bold" size={16} class="ico-check" />
        </button>
      </div>
    </div>

    {
      first && (
        <div class="specimen" data-specimen aria-roledescription="carrossel" aria-label="Itens reais do benchmark">
          <span class="specimen-progress" aria-hidden="true" style="--t:7s" />
          <div class="specimen-bar">
            <span class="left">
              <span class="code-tag" data-s="track">
                {first.track}
              </span>
              <span>
                <span data-s="task">{first.task}</span> · <span data-s="chamber">{first.chamber}</span>
              </span>
            </span>
            <span class="ref" data-s="ref">
              {first.ref}
            </span>
          </div>
          <div class="specimen-body" aria-live="polite">
            <div>
              <p class="specimen-label">Pergunta</p>
              <p class="specimen-q" data-s="prompt">
                {first.prompt}
              </p>
            </div>
            <div>
              <p class="specimen-label">Contexto entregue ao modelo</p>
              <p class="specimen-ctx" data-s="context">
                {first.context}
              </p>
            </div>
            <div>
              <p class="specimen-label">Gabarito oficial</p>
              <div class="specimen-answer" data-s="answer">
                {first.answer.map((a) => (
                  <span class="answer-token">{a}</span>
                ))}
              </div>
            </div>
            <p class="fine" data-s="model">
              {first.model}
            </p>
          </div>
          <div class="specimen-foot">
            <a class="link" data-s="url" href={first.url} target="_blank" rel="noopener">
              Fonte: <span data-s="host">{first.host}</span>
            </a>
            <div class="specimen-dots" role="group" aria-label="Escolher item">
              {specimens.map((s, i) => (
                <button
                  type="button"
                  data-go={i}
                  aria-label={`Item ${i + 1} de ${specimens.length}`}
                  aria-current={i === 0 ? 'true' : 'false'}
                />
              ))}
            </div>
          </div>
          <script type="application/json" id="specimens" set:html={serializeJson(specimens)} />
        </div>
      )
    }
  </section>

  <div class="shell">
    <div class="stat-strip" aria-label="O benchmark em números">
      <div>
        <div class="stat-value">{int(totalItems)}</div>
        <div class="stat-label">itens públicos, cada um com fonte oficial</div>
      </div>
      <div>
        <div class="stat-value">8</div>
        <div class="stat-label">trilhas, sem nota que junte todas</div>
      </div>
      <div>
        <div class="stat-value">{int(principalSlices.length)}</div>
        <div class="stat-label">fatias comparáveis de tarefa, casa e modo</div>
      </div>
      <div>
        <div class="stat-value">{runs.length}</div>
        <div class="stat-label">
          execuções publicadas: {modelCount}
          {modelCount === 1 ? ' modelo' : ' modelos'} e {runs.length - modelCount} referências
        </div>
      </div>
    </div>
  </div>

  <section id="resultados" class="shell section">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">Resultados</p>
        <h2 class="h-section">Matriz de capacidades</h2>
        <p class="body">
          Uma linha por tarefa e modo, uma coluna por execução. Troque para “acima da referência” e
          cada célula mostra a distância até o melhor respondedor sem modelo de linguagem.
        </p>
      </div>
      <a class="go" href={`${base}modelos/`}>
        Todas as execuções <Icon name="arrow-right" weight="regular" size={16} />
      </a>
    </div>

    {
      runs.length ? (
        <div class="panel" data-reveal style="--d:1">
          <div class="toolbar">
            <div class="group">
              <div class="seg" role="radiogroup" aria-label="Casa legislativa" data-seg data-matrix-chamber>
                {chambers.map((c, i) => (
                  <button type="button" role="radio" aria-checked={String(i === 0)} data-value={c}>
                    <span data-text={chamberNames[c]}>{chamberNames[c]}</span>
                  </button>
                ))}
              </div>
              <div class="seg" role="radiogroup" aria-label="Valor exibido" data-seg data-matrix-view>
                <button type="button" role="radio" aria-checked="true" data-value="score">
                  <span data-text="Nota">Nota</span>
                </button>
                <button type="button" role="radio" aria-checked="false" data-value="lift">
                  <span data-text="Acima da referência">Acima da referência</span>
                </button>
              </div>
            </div>
            <div class="group">
              <div class="scale" data-scale="score">
                <span>0</span>
                <span class="scale-bar" aria-hidden="true">
                  {[0, 1, 2, 3, 4, 5, 6].map((s) => (
                    <i style={`background:var(--seq-${s})`} />
                  ))}
                </span>
                <span>100%</span>
              </div>
              <div class="scale" data-scale="lift" hidden>
                <span>abaixo</span>
                <span class="scale-bar" aria-hidden="true">
                  {[-0.6, -0.3, -0.1, 0, 0.1, 0.3, 0.6].map((d) => (
                    <i style={`background:${liftColor(d).bg}`} />
                  ))}
                </span>
                <span>acima</span>
              </div>
              <button class="btn btn--outline btn--sm" type="button" data-export>
                <Icon name="download-simple" weight="regular" size={16} /> CSV
              </button>
            </div>
          </div>

          <div class="matrix-wrap" tabindex="0" role="region" aria-label="Matriz de capacidades, role para os lados">
            <table class="matrix" data-view="score">
              <caption class="sr-only">
                Nota por tarefa e modo para cada execução publicada. Clique numa linha para ver
                intervalos de confiança.
              </caption>
              <thead>
                <tr>
                  <th scope="col">Tarefa</th>
                  {columns.map((r) => (
                    <th scope="col" class:list={['col', { 'col--ref': r.kind === 'baseline' }]}>
                      <a href={`${base}modelos/${r.slug}/`}>
                        <span class={r.kind === 'baseline' ? 'swatch swatch--ref' : 'swatch'} style={`--c:${seriesColor(r.color)}`} />
                        <span class="n">{r.label}</span>
                        <small>{r.kind === 'baseline' ? 'referência' : r.org}</small>
                      </a>
                    </th>
                  ))}
                </tr>
              </thead>
              {chambers.map((chamber, ci) => (
                <tbody data-chamber={chamber} hidden={ci !== 0}>
                  {rowsByTrack.map((g) => (
                    <>
                      <tr class="group">
                        <th colspan={columns.length + 1} scope="colgroup">
                          <span class="code-tag">{g.id}</span>
                          {g.name}
                        </th>
                      </tr>
                      {g.rows.map(({ task, mode }) => {
                        const slice = sliceFor(task, mode, chamber);
                        return (
                          <tr class="row">
                            <th scope="row">
                              {slice ? (
                                <button type="button" class="row-btn" data-slice={slice.key}>
                                  <span>
                                    {taskNames[task] || task}
                                    <span class="mode"> · {modeNames[mode] || mode}</span>
                                  </span>
                                </button>
                              ) : (
                                <span class="row-btn">
                                  {taskNames[task] || task}
                                  <span class="mode"> · {modeNames[mode] || mode}</span>
                                </span>
                              )}
                            </th>
                            {columns.map((r) => {
                              const cell = slice?.cells[r.id];
                              if (!slice || !cell)
                                return (
                                  <td class="empty" aria-label="Sem dados">
                                    —
                                  </td>
                                );
                              const s = seqColor(cell.mean);
                              const lift = r.kind === 'model' && slice.floor !== null ? cell.mean - slice.floor : null;
                              const l = lift === null ? { bg: '', fg: '' } : liftColor(lift);
                              const thin = cell.families < 5;
                              return (
                                <td
                                  tabindex="0"
                                  class:list={[{ thin, ref: r.kind === 'baseline' }]}
                                  style={`--cell-bg:${s.bg};--cell-fg:${s.fg};${l.bg ? `--lift-bg:${l.bg};--lift-fg:${l.fg}` : ''}`}
                                  data-tip={tipData(
                                    `${r.label} · ${taskNames[task] || task}`,
                                    pct(cell.mean),
                                    [
                                      ['IC 95%', `${pct(cell.low)} a ${pct(cell.high)}`],
                                      ['Respostas', int(cell.n)],
                                      ['Famílias', int(cell.families)],
                                      ...(lift !== null ? ([['Contra a melhor referência', pp(lift)]] as [string, string][]) : []),
                                    ],
                                    thin
                                      ? `Só ${cell.families} ${cell.families === 1 ? 'família' : 'famílias'}: o intervalo informa pouco.`
                                      : undefined,
                                  )}
                                >
                                  <span data-v="score">{Math.round(cell.mean * 100)}</span>
                                  <span data-v="lift">
                                    {lift === null ? 'ref.' : `${lift > 0.004 ? '+' : lift < -0.004 ? '−' : '±'}${Math.abs(Math.round(lift * 100))}`}
                                  </span>
                                </td>
                              );
                            })}
                          </tr>
                        );
                      })}
                    </>
                  ))}
                </tbody>
              ))}
            </table>
          </div>
          <p class="note">
            Valores em pontos percentuais. O ponto no canto da célula marca fatias com menos de cinco
            famílias, em que o intervalo de confiança é largo ou degenerado. Tarefas experimentais e
            diferenças pareadas da trilha H ficam nos perfis de cada execução.
          </p>
          {lifts.length > 0 && (
            <div class="verdicts" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr))">
              {lifts.map((l) => (
                <div>
                  <p class="fine" style="display:flex;align-items:center;gap:8px">
                    <span class="swatch" style={`--c:${seriesColor(l.run.color)}`} /> {l.run.label}
                  </p>
                  <p style="margin-top:10px;font-size:15px;color:var(--color-ink)">
                    <strong>{l.above}</strong> de {l.total} fatias com o intervalo inteiro acima da melhor
                    referência; <strong>{l.below}</strong> abaixo; {l.overlap} indefinidas.
                  </p>
                  <div class="lift-bar" style="margin-top:12px" role="img" aria-label={`${l.above} acima, ${l.overlap} indefinidas, ${l.below} abaixo`}>
                    <i class="up" style={`flex:${l.above}`} />
                    <i class="eq" style={`flex:${l.overlap}`} />
                    <i class="dn" style={`flex:${l.below}`} />
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      ) : (
        <div class="empty-state">
          <Icon name="chart-scatter" size={32} />
          <h3>Nenhuma execução publicada ainda</h3>
          <p>As notas aparecem aqui depois da primeira execução documentada.</p>
          <a class="btn" href={`${base}contribuir/`}>Avaliar um modelo</a>
        </div>
      )
    }
    <script type="application/json" id="payload" set:html={serializeJson(clientPayload)} />
  </section>

  <section class="tagline" aria-label="Princípio do Teor">
    <div class="shell">
      <p class="eyebrow" style="color:var(--color-brand-soft)">Por que assim</p>
      <h2 class="tagline-text" data-tagline style="margin-top:20px">
        Nenhuma nota sai daqui sem a tarefa, o intervalo e o registro oficial que a sustentam.
      </h2>
      <p class="tagline-foot">
        Modelos erram com confiança, e uma média bonita esconde onde. Por isso o Teor publica cada
        fatia em separado, deixa as referências triviais à vista e liga cada gabarito ao endpoint de
        onde ele saiu.
      </p>
    </div>
  </section>

  <section id="trilhas" class="shell section">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">O que medimos</p>
        <h2 class="h-section">Oito trilhas, uma capacidade em cada</h2>
        <p class="body">
          Ler um registro, aplicar uma regra, contar votos, seguir a tramitação, prever, citar, usar
          ferramentas e manter a resposta quando só o partido muda.
        </p>
      </div>
      <a class="go" href={`${base}trilhas/`}>
        Detalhes de cada trilha <Icon name="arrow-right" weight="regular" size={16} />
      </a>
    </div>

    <div data-reveal style="--d:1">
      <div class="composition" data-composition role="group" aria-label="Itens do conjunto por trilha">
        {
          trackPayload.map((t, i) => (
            <button
              type="button"
              style={`flex:${t.n};--i:${i}`}
              data-track={t.id}
              data-tip={tipData(`Trilha ${t.id} · ${t.name}`, `${int(t.n)} itens`, [
                ['Parte do conjunto', pct(t.n / Math.max(1, totalItems))],
              ])}
              aria-label={`${t.id}, ${t.name}: ${t.n} itens`}
            >
              {t.n / totalItems > 0.06 && <span class="lbl">{t.id}</span>}
            </button>
          ))
        }
      </div>
      <p class="note" style="margin-top:10px">
        A trilha A concentra a maior parte dos itens porque proposições são o registro mais abundante.
        Trilhas com poucos itens aparecem com intervalos largos na matriz.
      </p>
    </div>

    <div class="track-explorer" style="margin-top:32px">
      <div class="track-list" role="tablist" aria-label="Trilhas" aria-orientation="vertical" data-reveal>
        {
          trackPayload.map((t, i) => (
            <button
              class="track-row"
              type="button"
              role="tab"
              id={`tab-${t.id}`}
              aria-controls="track-panel"
              aria-selected={String(i === 0)}
              tabindex={i === 0 ? 0 : -1}
              data-track={t.id}
            >
              <span class="code-tag">{t.id}</span>
              <span>
                <span class="name">{t.name}</span>
                <span class="desc">{t.desc}</span>
              </span>
              <span class="n">{int(t.n)}</span>
            </button>
          ))
        }
      </div>
      <div class="track-detail" data-reveal style="--d:2">
        <div class="panel" id="track-panel" role="tabpanel" aria-labelledby={`tab-${firstTrack.id}`}>
          <div class="track-detail-body" data-track-body>
            <div style="display:flex;align-items:center;gap:12px">
              <span class="code-tag" style="width:36px;height:36px;font-size:16px" data-t="id">
                {firstTrack.id}
              </span>
              <h3 class="h-block" data-t="name">{firstTrack.name}</h3>
            </div>
            <dl class="dl">
              <div>
                <dt>Pergunta de avaliação</dt>
                <dd data-t="question">{firstTrack.question}</dd>
              </div>
              <div>
                <dt>Como medimos</dt>
                <dd data-t="method">{firstTrack.method}</dd>
              </div>
              <div>
                <dt>O que a nota não diz</dt>
                <dd data-t="limitation">{firstTrack.limitation}</dd>
              </div>
              <div>
                <dt>Exemplo de pergunta</dt>
                <dd data-t="example" style="font-family:'Newsreader',serif;font-size:19px;line-height:1.35;color:var(--color-ink)">
                  {firstTrack.example}
                </dd>
              </div>
            </dl>
            <div style="display:flex;flex-wrap:wrap;gap:16px;margin-top:26px">
              <a class="go" data-t="explore" href={`${base}explorador/?track=${firstTrack.id}`}>
                Ver os itens <Icon name="arrow-right" weight="regular" size={16} />
              </a>
              <a class="go" data-t="page" href={`${base}trilhas/${firstTrack.id.toLowerCase()}/`}>
                Página da trilha <Icon name="arrow-right" weight="regular" size={16} />
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <script type="application/json" id="track-payload" set:html={serializeJson(trackPayload)} />
  </section>

  <section class="shell section rule-top" id="como-funciona">
    <div class="pipeline">
      <div data-reveal>
        <p class="eyebrow">Reproduzir</p>
        <h2 class="h-section" style="margin-top:14px">Do endpoint oficial ao JSON de métricas</h2>
        <p class="body" style="margin-top:12px">
          Tudo roda na sua máquina com <code class="mono">uv</code>. Coleta e construção não pedem chave
          de API; só a avaliação do modelo gasta tokens, e com teto definido por você.
        </p>
        <div class="steps" role="tablist" aria-label="Etapas do pipeline" style="margin-top:28px">
          {
            pipeline.map((step, i) => (
              <button
                class="step"
                type="button"
                role="tab"
                aria-selected={String(i === 0)}
                tabindex={i === 0 ? 0 : -1}
                aria-controls="term"
                data-step={i}
              >
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                <span>
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </span>
              </button>
            ))
          }
        </div>
      </div>
      <div data-reveal style="--d:1;align-self:center">
        <div class="term" id="term" role="tabpanel">
          <div class="term-bar">
            <span class="lights" aria-hidden="true"><i /><i /><i /></span>
            <span data-term-title>teor · {pipeline[0].title.toLowerCase()}</span>
            <button class="icon-btn copy" type="button" data-copy data-copy-target="#term-cmds" aria-label="Copiar comandos">
              <Icon name="copy" weight="regular" size={16} class="ico-copy" />
              <Icon name="check" weight="bold" size={16} class="ico-check" />
            </button>
          </div>
          <pre data-term tabindex="0" aria-label="Comandos"><code>{pipeline[0].code.map(([k, line]) => (
            <span class={k}>{k === 'p' ? '$ ' : ''}{line}{'\n'}</span>
          ))}</code></pre>
          <span id="term-cmds" hidden>
            {pipeline[0].code.filter(([k]) => k === 'p' || k === 'o').map(([, l]) => l).join('\n')}
          </span>
        </div>
      </div>
    </div>
    <script type="application/json" id="pipeline" set:html={serializeJson(pipeline)} />
  </section>

  <section id="perguntas" class="shell section rule-top">
    <div class="split">
      <div data-reveal>
        <p class="eyebrow">Dúvidas</p>
        <h2 class="h-section" style="margin-top:14px">Antes de citar um número</h2>
        <a class="go" style="margin-top:20px" href={`${base}metodologia/`}>
          Metodologia completa <Icon name="arrow-right" weight="regular" size={16} />
        </a>
      </div>
      <div class="faq" data-reveal style="--d:1">
        {
          faqs.map(([q, a]) => (
            <details>
              <summary>
                {q}
                <span class="plus" aria-hidden="true" />
              </summary>
              <p>{a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <div class="shell">
    <div class="cta-band">
      <div>
        <h2>Rode o Teor no seu modelo.</h2>
        <p>Protocolo aberto, preflight de formato e teto de gasto. O resultado entra por pull request.</p>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:10px">
        <a class="btn btn--lg" href={`${base}contribuir/`}>
          Avaliar um modelo <Icon name="arrow-right" weight="regular" size={18} />
        </a>
        <a class="btn btn--outline btn--lg" href="https://github.com/como-votam/teor">
          <Icon name="github-logo" weight="regular" size={18} /> GitHub
        </a>
      </div>
    </div>
  </div>
</Layout>

