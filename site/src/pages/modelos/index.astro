---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import { runs, liftSummary, providerOf, orderingScore } from '../../data/derived';
import { pct, secs, date, compact } from '../../lib/format';
import { seriesColor } from '../../lib/charts';
const base = import.meta.env.BASE_URL;
const PAGE = 10;
// Ordem inicial: modelos pelas fatias acima da referência, depois as referências.
const rows = runs
  .map((r) => ({ r, lift: r.kind === 'model' ? liftSummary(r.id) : null, provider: providerOf(r) }))
  .sort((a, b) =>
    a.r.kind !== b.r.kind
      ? a.r.kind === 'model'
        ? -1
        : 1
      : (b.lift?.above ?? 0) - (a.lift?.above ?? 0) || orderingScore(b.r.id) - orderingScore(a.r.id),
  );
const providers = [...new Set(rows.map((x) => x.provider))];
const sameCohort = new Set(runs.map((r) => `${r.datasetHash}:${r.protocolHash}`)).size === 1;
---

<Layout title="Referências e modelos">
  <Breadcrumbs />
  <section class="shell page-hero">
    <h1 class="h-page">Execuções publicadas</h1>
    <p class="sub">
      Cada linha é uma execução completa do protocolo, com cobertura, latência e o que ficou acima das
      referências.
    </p>
  </section>

  <section class="shell" style="padding-bottom:40px" data-runs data-page-size={PAGE}>
    {
      sameCohort && runs.length > 0 && (
        <div class="callout" style="margin-bottom:20px">
          <Icon name="seal-check" size={18} />
          <span>
            Todas as execuções usam o mesmo conjunto (<code class="mono">{runs[0].datasetHash.slice(0, 8)}</code>) e o mesmo
            protocolo (<code class="mono">{runs[0].protocolHash.slice(0, 8)}</code>), então as fatias são comparáveis entre
            linhas.
          </span>
        </div>
      )
    }
    {
      runs.length ? (
        <>
          <div class="rt-bar">
            <label class="field rt-search">
              <Icon name="magnifying-glass" weight="regular" size={17} />
              <span class="sr-only">Buscar execução</span>
              <input type="search" placeholder="Buscar modelo ou provedor" autocomplete="off" spellcheck="false" data-rt-search />
            </label>
            <div class="seg" role="radiogroup" aria-label="Tipo de execução" data-seg data-rt-kind>
              {[['', 'Todas'], ['model', 'Modelos'], ['baseline', 'Referências']].map(([v, l], i) => (
                <button type="button" role="radio" aria-checked={i === 0} data-value={v}>
                  <span data-text={l}>{l}</span>
                </button>
              ))}
            </div>
            <div
              data-select-mount={JSON.stringify({
                name: 'provider',
                label: 'Provedor',
                value: '',
                options: [{ value: '', label: 'Todos os provedores' }, ...providers.map((p) => ({ value: p, label: p }))],
              })}
              data-rt-provider
            >
              <button class="select-trigger" type="button" disabled>Todos os provedores</button>
            </div>
          </div>
          <div class="table-wrap" data-sortable>
            <table class="table">
              <caption class="sr-only">Execuções publicadas no Teor. Os cabeçalhos com seta ordenam a tabela.</caption>
              <thead>
                <tr>
                  <th scope="col">Execução</th>
                  <th scope="col">
                    <button class="sort" type="button" data-key="above" data-dir="desc">
                      Acima da referência <Icon name="caret-down" weight="bold" size={12} />
                    </button>
                  </th>
                  <th scope="col" class="num">
                    <button class="sort" type="button" data-key="coverage">
                      Cobertura <Icon name="caret-down" weight="bold" size={12} />
                    </button>
                  </th>
                  <th scope="col" class="num">
                    <button class="sort" type="button" data-key="latency">
                      Latência média <Icon name="caret-down" weight="bold" size={12} />
                    </button>
                  </th>
                  <th scope="col" class="num">Tokens</th>
                  <th scope="col">
                    <button class="sort" type="button" data-key="date">
                      Data <Icon name="caret-down" weight="bold" size={12} />
                    </button>
                  </th>
                </tr>
              </thead>
              <tbody>
                {rows.map(({ r, lift, provider }, i) => (
                  <tr
                    data-row
                    data-name={`${r.label} ${r.model} ${provider}`.toLowerCase()}
                    data-kind={r.kind}
                    data-provider={provider}
                    data-above={lift ? lift.above / Math.max(1, lift.total) : -1}
                    data-coverage={r.coverage}
                    data-latency={r.latency ?? -1}
                    data-date={r.date}
                    hidden={i >= PAGE}
                  >
                    <th scope="row">
                      <a class="run-name" href={`${base}modelos/${r.slug}/`}>
                        <span class={r.kind === 'baseline' ? 'swatch swatch--ref' : 'swatch'} style={`--c:${seriesColor(r.color)}`} />
                        <span style="min-width:0">
                          <span class="t">{r.label}</span>
                          <small>{r.kind === 'baseline' ? 'Referência determinística' : provider}</small>
                        </span>
                      </a>
                    </th>
                    <td>
                      {lift ? (
                        <span style="display:flex;align-items:center;gap:12px">
                          <span class="lift-bar" style="width:120px" role="img" aria-label={`${lift.above} acima, ${lift.overlap} indefinidas, ${lift.below} abaixo`}>
                            <i class="up" style={`flex:${lift.above}`} />
                            <i class="eq" style={`flex:${lift.overlap}`} />
                            <i class="dn" style={`flex:${lift.below}`} />
                          </span>
                          <span class="tnum" style="font-size:13.5px">
                            {lift.above}/{lift.total}
                          </span>
                        </span>
                      ) : (
                        <span class="fine">é o piso</span>
                      )}
                    </td>
                    <td class="num">{pct(r.coverage)}</td>
                    <td class="num">{secs(r.latency)}</td>
                    <td class="num">{r.tokensIn ? `${compact(r.tokensIn)} → ${compact(r.tokensOut)}` : '—'}</td>
                    <td class="nowrap">{date(r.date)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <div class="rt-empty" data-rt-empty hidden>
              <p>Nenhuma execução com esses filtros.</p>
              <button class="btn btn--outline btn--sm" type="button" data-rt-clear>Limpar filtros</button>
            </div>
          </div>
          <nav class="pager" aria-label="Paginação das execuções" data-pager>
            <span class="pager-info" role="status" data-pager-info>
              1–{Math.min(PAGE, rows.length)} de {rows.length}
            </span>
            <div class="pager-pages" data-pager-pages />
          </nav>
        </>
      ) : (
        <div class="empty-state">
          <Icon name="chart-scatter" size={32} />
          <h2>Nenhum resultado publicado</h2>
          <p>As avaliações entram aqui depois de uma execução documentada e validada.</p>
          <a class="btn" href={`${base}contribuir/`}>Como submeter uma avaliação</a>
        </div>
      )
    }
    <p class="note">
      “Acima da referência” conta as fatias em que o intervalo de confiança inteiro do modelo fica
      acima da melhor referência determinística da mesma fatia. Intervalos que tocam o piso contam
      como indefinidos, não como empate.
    </p>
  </section>

  <section class="shell section--tight" style="padding-bottom:96px">
    <div class="cards cards--3">
      <a class="card-link" href={`${base}comparar/`}>
        <Icon name="scales" size={28} />
        <h3>Comparar duas execuções</h3>
        <p>Diferença fatia por fatia, com a sobreposição dos intervalos à vista.</p>
        <span class="go">Abrir comparação <Icon name="arrow-right" weight="regular" size={16} /></span>
      </a>
      <a class="card-link" href={`${base}resultados/index.json`}>
        <Icon name="brackets-curly" size={28} />
        <h3>Catálogo em JSON</h3>
        <p>Métricas públicas de todas as execuções, para análise própria ou reprodução.</p>
        <span class="go">resultados/index.json <Icon name="arrow-right" weight="regular" size={16} /></span>
      </a>
      <a class="card-link" href={`${base}contribuir/`}>
        <Icon name="flask" size={28} />
        <h3>Submeter uma execução</h3>
        <p>Rode o protocolo no seu modelo e abra um pull request com o JSON de métricas.</p>
        <span class="go">Avaliar um modelo <Icon name="arrow-right" weight="regular" size={16} /></span>
      </a>
    </div>
  </section>
</Layout>

<script>
  import { $, $$, h, icon } from '../../scripts/ui/core';
  // Busca, filtros, ordenação e paginação sobre as linhas já renderizadas no HTML.
  const root = $('[data-runs]');
  if (root) {
    const tbody = $('tbody', root)!;
    const all = $$<HTMLTableRowElement>('tr[data-row]', tbody);
    const size = Number(root.dataset.pageSize) || 10;
    const info = $('[data-pager-info]', root)!;
    const pages = $('[data-pager-pages]', root)!;
    const empty = $('[data-rt-empty]', root)!;
    const search = $<HTMLInputElement>('[data-rt-search]', root)!;
    let q = '';
    let kind = '';
    let provider = '';
    let page = 0;

    const filtered = () =>
      $$<HTMLTableRowElement>('tr[data-row]', tbody).filter(
        (r) => (!q || r.dataset.name!.includes(q)) && (!kind || r.dataset.kind === kind) && (!provider || r.dataset.provider === provider),
      );
    function render() {
      const list = filtered();
      const count = Math.max(1, Math.ceil(list.length / size));
      page = Math.min(page, count - 1);
      const from = page * size;
      all.forEach((r) => (r.hidden = true));
      list.slice(from, from + size).forEach((r) => (r.hidden = false));
      empty.hidden = list.length > 0;
      info.textContent = list.length ? `${from + 1}–${Math.min(from + size, list.length)} de ${list.length}` : `0 de ${all.length}`;
      const btn = (label: string | Node, to: number, opts: { current?: boolean; disabled?: boolean; aria?: string } = {}) =>
        h(
          'button',
          {
            type: 'button',
            class: 'pager-btn',
            'aria-current': opts.current ? 'page' : null,
            'aria-label': opts.aria || null,
            disabled: opts.disabled ? true : null,
            onclick: () => {
              page = to;
              render();
            },
          },
          label,
        );
      pages.replaceChildren(
        btn(icon('arrowRight', 14, 'flip'), page - 1, { disabled: page === 0, aria: 'Página anterior' }),
        ...Array.from({ length: count }, (_, i) => btn(String(i + 1), i, { current: i === page, aria: `Página ${i + 1}` })),
        btn(icon('arrowRight', 14), page + 1, { disabled: page >= count - 1, aria: 'Próxima página' }),
      );
      pages.hidden = list.length <= size;
    }
    let t: ReturnType<typeof setTimeout>;
    search.addEventListener('input', () => {
      clearTimeout(t);
      t = setTimeout(() => {
        q = search.value.trim().toLowerCase();
        page = 0;
        render();
      }, 80);
    });
    $('[data-rt-kind]', root)?.addEventListener('seg', (e) => {
      kind = (e as CustomEvent).detail.value;
      page = 0;
      render();
    });
    $('[data-rt-provider]', root)?.addEventListener('select', (e) => {
      provider = (e as CustomEvent).detail.value;
      page = 0;
      render();
    });
    $('[data-rt-clear]', root)?.addEventListener('click', () => {
      search.value = '';
      q = '';
      provider = '';
      kind = '';
      $<HTMLElement & { select?: { set: (v: string) => void } }>('[data-rt-provider]', root)?.select?.set('');
      $<HTMLButtonElement>('[data-rt-kind] button[data-value=""]', root)?.click();
      page = 0;
      render();
    });

    // Ordenação: reordena as linhas no DOM e volta para a primeira página.
    const buttons = $$<HTMLButtonElement>('.sort', root);
    buttons.forEach((b) => {
      if (b.dataset.dir) b.closest('th')!.setAttribute('aria-sort', 'descending');
      b.addEventListener('click', () => {
        const key = b.dataset.key!;
        const dir = b.dataset.dir === 'desc' ? 'asc' : 'desc';
        buttons.forEach((x) => {
          delete x.dataset.dir;
          x.closest('th')!.removeAttribute('aria-sort');
        });
        b.dataset.dir = dir;
        b.closest('th')!.setAttribute('aria-sort', dir === 'asc' ? 'ascending' : 'descending');
        const val = (r: HTMLTableRowElement) => (key === 'date' ? Date.parse(r.dataset.date!) : Number(r.dataset[key]));
        all.sort((a, c) => (dir === 'asc' ? 1 : -1) * (val(a) - val(c))).forEach((r) => tbody.append(r));
        page = 0;
        render();
      });
    });
    render();
  }
</script>
