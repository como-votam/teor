---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import { data } from '../data';
import { date } from '../lib/format';
const base = import.meta.env.BASE_URL;
---

<Layout title="Rodadas Live">
  <Breadcrumbs />
  <section class="shell page-hero">
    <h1 class="h-page">Perguntas novas, gabarito só depois do prazo</h1>
    <p class="sub">
      Um lote com votações posteriores ao corte de treinamento é a forma mais limpa de afastar
      memorização. Não presumimos saber o corte de cada modelo.
    </p>
  </section>
  <section class="shell" style="padding-bottom:96px">
    <div class="timeline-steps">
      <div>
        <span class="num">01</span>
        <h3>Lote congelado</h3>
        <p>Itens, protocolo e hash ficam fixos antes da abertura.</p>
      </div>
      <div>
        <span class="num">02</span>
        <h3>Previsões até o prazo</h3>
        <p>Submissões chegam sem acesso ao gabarito, que permanece privado.</p>
      </div>
      <div>
        <span class="num">03</span>
        <h3>Gabarito publicado</h3>
        <p>No fechamento saem respostas, notas e a lista completa de submissões.</p>
      </div>
    </div>
    <div style="margin-top:40px">
      {
        data.rounds.length ? (
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr><th>Rodada</th><th>Abertura</th><th>Fechamento</th><th>Divulgação</th></tr>
              </thead>
              <tbody>
                {data.rounds.map((r) => (
                  <tr data-row>
                    <th scope="row" class="mono">{r.id}</th>
                    <td>{date(r.opens_at)}</td>
                    <td>{date(r.closes_at)}</td>
                    <td>{date(r.published_at)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="empty-state">
            <Icon name="clock" size={32} />
            <h2>Nenhuma rodada publicada ainda</h2>
            <p>As datas e os resultados aparecem aqui quando a primeira rodada fechar e o gabarito sair.</p>
            <a class="btn btn--ink" href={`${base}contribuir/`}>Como participar</a>
          </div>
        )
      }
    </div>
  </section>
</Layout>
