---
import Layout from '../layouts/Layout.astro';
import { data } from '../data';
---

<Layout title="Rodadas Live">
  <p class="eyebrow">LOTES NOVOS · DIVULGAÇÃO APÓS FECHAMENTO</p>
  <h1>
    O benchmark
    <br />
    também muda.
  </h1>
  <p>
    Rodadas congelam um lote, recebem previsões até o prazo e divulgam o gabarito após o fechamento.
    Não presumimos conhecer o corte de treinamento de cada modelo.
  </p>
  <div class="round-steps">
    <article>
      <span class="track-code">01</span>
      <h3>Lote congelado</h3>
      <p>Os itens e o protocolo são definidos antes da rodada.</p>
    </article>
    <article>
      <span class="track-code">02</span>
      <h3>Previsões recebidas</h3>
      <p>As submissões chegam até o prazo de fechamento.</p>
    </article>
    <article>
      <span class="track-code">03</span>
      <h3>Gabarito publicado</h3>
      <p>Respostas e resultados são divulgados após o fechamento.</p>
    </article>
  </div>
  {data.rounds.length ? (
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Rodada</th>
            <th>Abertura</th>
            <th>Fechamento</th>
            <th>Divulgação</th>
          </tr>
        </thead>
        <tbody>
          {data.rounds.map((r) => (
            <tr>
              <td>{r.id}</td>
              <td>{r.opens_at}</td>
              <td>{r.closes_at}</td>
              <td>{r.published_at}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <div class="empty">
      <h2>Nenhuma rodada publicada</h2>
      <p>As datas e os resultados aparecem aqui quando uma rodada for concluída e divulgada.</p>
      <a class="button" href={`${import.meta.env.BASE_URL}contribuir/`}>
        Como participar →
      </a>
    </div>
  )}
</Layout>
