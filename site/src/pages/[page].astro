---
import Layout from '../layouts/Layout.astro';
import type { MarkdownInstance } from 'astro';
const docs = import.meta.glob<MarkdownInstance<Record<string, unknown>>>('../../../docs/*.md', {
  eager: true,
});
export function getStaticPaths() {
  const pages = [
    ['metodologia', 'metodologia', 'Metodologia'],
    ['dados', 'dataset-card', 'Dados e fontes'],
    ['erratas', 'erratas', 'Erratas'],
    ['contribuir', 'contribuir', 'Como contribuir'],
    ['revisar', 'revisar', 'Revisar itens'],
  ];
  return pages.map(([page, file, title]) => ({ params: { page }, props: { file, title } }));
}
const { file, title } = Astro.props;
const { Content } = docs[`../../../docs/${file}.md`];
---

<Layout title={title}>
  <div class="document-shell">
    <nav class="document-nav" aria-label="Documentação">
      <p class="eyebrow">Documentação</p>
      {[
        ['metodologia', 'Metodologia'],
        ['dados', 'Dados e fontes'],
        ['contribuir', 'Contribuir'],
        ['revisar', 'Revisar itens'],
        ['erratas', 'Erratas'],
      ].map(([href, label]) => (
        <a
          href={`${import.meta.env.BASE_URL}${href}/`}
          aria-current={Astro.params.page === href ? 'page' : undefined}
        >
          {label}
        </a>
      ))}
    </nav>
    <article class="prose">
      <Content />
    </article>
  </div>
</Layout>
