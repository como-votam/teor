---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import DocShell from '../components/DocShell.astro';
import type { MarkdownInstance } from 'astro';
const docs = import.meta.glob<MarkdownInstance<Record<string, unknown>>>('../../../docs/*.md', {
  eager: true,
});
export function getStaticPaths() {
  const pages = [
    ['metodologia', 'metodologia', 'Metodologia'],
    ['dados', 'dataset-card', 'Dados e fontes'],
    ['erratas', 'erratas', 'Erratas'],
    ['contribuir', 'contribuir', 'Como contribuir'],
    ['revisar', 'revisar', 'Revisar itens'],
  ];
  return pages.map(([page, file, title]) => ({ params: { page }, props: { file, title } }));
}
const { file, title } = Astro.props;
const doc = docs[`../../../docs/${file}.md`];
const { Content } = doc;
---

<Layout title={title}>
  <Breadcrumbs />
  <DocShell current={Astro.params.page!} headings={doc.getHeadings()}>
    <Content />
  </DocShell>
</Layout>
