---
// Phosphor (peso light por padrão), inline no build: nenhuma fonte de ícones, nenhum request.
import fs from 'node:fs';
import path from 'node:path';
interface Props {
  name: string;
  size?: number;
  weight?: 'light' | 'regular' | 'bold' | 'fill';
  class?: string;
  label?: string;
}
const { name, size = 20, weight = 'light', class: className, label } = Astro.props;
const file = path.resolve(
  'node_modules/@phosphor-icons/core/assets',
  weight,
  weight === 'regular' ? `${name}.svg` : `${name}-${weight}.svg`,
);
const raw = fs.readFileSync(file, 'utf8');
const inner = raw.replace(/^<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 256 256"
  width={size}
  height={size}
  fill="currentColor"
  class={className}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={inner}
/>
