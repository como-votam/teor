const { name = 'arrow', size = 20 } = Astro.props;
const paths: Record<string, string> = {
  arrow: 'M4 12h16m-6-6 6 6-6 6',
  external: 'M14 4h6v6M20 4 10 14M10 4H4v16h16v-6',
  chart: 'M4 20V4m0 16h16M8 16v-5m5 5V7m5 9V3',
  book: 'M12 5v15M12 5C8 2 4 3 2 4v15c4-2 7-1 10 1m0-15c4-3 8-2 10-1v15c-4-2-7-1-10 1',
  code: 'm8 6-6 6 6 6m8-12 6 6-6 6M14 3l-4 18',
  search: 'M21 21l-5-5M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0',
  check: 'm5 12 4 4L19 6',
  layers: 'm12 2 10 5-10 5L2 7Zm-10 10 10 5 10-5M2 17l10 5 10-5',
  download: 'M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5',
  reset: 'M3 10a9 9 0 1 1 2 8M3 3v7h7',
  info: 'M12 11v6m0-10v1M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0',
