---
import { overview } from '../../lib/seo/registry';
import { urls } from '../../lib/seo/config';
---

<aside class="panel" data-citable aria-labelledby="citable-title" style="margin-top:40px">
  <h2 id="citable-title" class="h-panel">O benchmark em dados</h2>
  <p class="fine" style="margin-top:8px">{overview.summary}</p>
  <dl class="kv" style="margin-top:16px">
    {
      overview.facts.map((f) => (
        <>
          <dt>{f.label}</dt>
          <dd>
            {f.value.toLocaleString('pt-BR')} {f.unit}
          </dd>
        </>
      ))
    }
  </dl>
  <p class="fine">
    Escopo: artefatos públicos desta publicação. <a class="link" href={urls.path('dados/')}>Fontes e reuso</a> ·
    <a class="link" href={urls.path('como-citar/')}>Como citar</a>
  </p>
</aside>
